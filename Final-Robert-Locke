        "# TODO: Write a comment here that says what order_total does.\n",
        "def order_total(order, menu, tax_rate=0.08):\n",
        "    subtotal = 0\n",
        "    for item in order:\n",
        "        subtotal += get_price(menu, item)\n",
        "    total = subtotal * (1 + tax_rate)\n",
        "    return round(total, 2)"
