        "```python\n",
        "score = 7\n",
        "if score >= 9:\n",
        "    print('High')\n",
        "elif score >= 5:\n",
        "    print('Medium')\n",
        "else:\n",
        "    print('Low')       # prints: Medium\n",
        "```"
